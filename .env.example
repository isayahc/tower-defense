# Server-only configuration. No Supabase or provider key is used by this game.
# Set this to an installed checkout containing Open-Industries SQLite runtime v2.
OI_CHECKOUT=../Open-Industries
OI_GAME_SERVICE_URL=http://127.0.0.1:8790
PORT=3000
# Set an exact https origin when using a TLS reverse proxy on the same host.
# The backend binds loopback and requires the proxy to preserve this Host header.
# TD_PUBLIC_ORIGIN=https://game.example.com
